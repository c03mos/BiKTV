<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ktv_controls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="18dp"
    android:background="@drawable/ktv_controller_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageButton
        android:id="@+id/ktv_refresh"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="刷新资源"
        android:src="@android:drawable/ic_popup_sync"
        android:tint="@color/ktv_control" />

    <ImageButton
        android:id="@+id/ktv_rew"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="快退"
        android:src="@android:drawable/ic_media_rew"
        android:tint="@color/ktv_control" />

    <ImageButton
        android:id="@+id/ktv_play_pause"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="播放或暂停"
        android:src="@android:drawable/ic_media_play"
        android:tint="@color/ktv_control" />

    <ImageButton
        android:id="@+id/ktv_ffwd"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="快进"
        android:src="@android:drawable/ic_media_ff"
        android:tint="@color/ktv_control" />

    <ImageButton
        android:id="@+id/ktv_skip"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="切歌"
        android:src="@android:drawable/ic_media_next"
        android:tint="@color/ktv_control" />

    <ImageButton
        android:id="@+id/ktv_settings"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="设置"
        android:src="@android:drawable/ic_menu_manage"
        android:tint="@color/ktv_control" />
</LinearLayout>
